# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Modo de autenticación ---
# true  = Etapa 1: auth simulada en memoria, sin Supabase real.
#         Usá el header X-Mock-Rol: cliente | admin | super_admin para elegir usuario.
# false = Etapa 2: JWT de Supabase real. Requiere las vars de Supabase abajo.
MOCK_AUTH=true

# URL pública de la app (se codifica dentro del QR de cada evento)
APP_URL=http://localhost:3000

# --- Supabase ---
# Proyecto compartido con el resto de productos GIZA (tablas aisladas por prefijo vidriera_)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon) — usada para operaciones en nombre del usuario autenticado
SUPABASE_ANON_KEY=

# Clave de servicio (service_role) — SOLO backend, nunca exponer al cliente.
# Se usa para operaciones administrativas que saltan RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto JWT del proyecto Supabase — para verificar tokens localmente si hiciera falta.
SUPABASE_JWT_SECRET=
