# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Supabase ---
# Proyecto compartido con el resto de productos GIZA (tablas aisladas por prefijo vidriera_)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon) — usada para operaciones en nombre del usuario autenticado
SUPABASE_ANON_KEY=

# Clave de servicio (service_role) — SOLO backend, nunca exponer al cliente.
# Se usa para operaciones administrativas que saltan RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto JWT del proyecto Supabase — para verificar tokens localmente si hiciera falta.
SUPABASE_JWT_SECRET=
